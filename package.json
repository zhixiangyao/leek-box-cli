{
  "name": "leek-box-cli",
  "version": "0.8.0",
  "description": "韭菜盒子, 终端股票自选股看板, 基于 Ink 构建的交互式 CLI 工具",
  "keywords": [
    "a股",
    "cli",
    "ink",
    "quote",
    "stock",
    "tui",
    "韭菜盒子"
  ],
  "homepage": "https://github.com/zhixiangyao/leek-box-cli#readme",
  "bugs": {
    "url": "https://github.com/zhixiangyao/leek-box-cli/issues"
  },
  "license": "MIT",
  "author": "zhixiangyao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhixiangyao/leek-box-cli.git"
  },
  "bin": {
    "leek-box-cli": "dist/main.mjs"
  },
  "files": [
    "dist/main.mjs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "tsx src/main.tsx",
    "mock": "tsx scripts/mock.ts",
    "preview": "node dist/main.mjs",
    "------------- TOOLS -------------": "",
    "release": "tsx scripts/release.tsx",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsrs --noEmit -p tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint",
    "lint-staged": "lint-staged",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "ink": "8.0.0",
    "react": "19.3.1",
    "string-width": "8.3.0",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.1.0",
    "lint-staged": "17.6.0",
    "oxfmt": "0.76.0",
    "oxlint": "1.91.0",
    "simple-git-hooks": "2.14.0",
    "tsrs": "0.21.0-ts7.1.0-beta",
    "tsx": "4.23.15",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged && pnpm typecheck && pnpm test"
  },
  "lint-staged": {
    "**/*.{js,cjs,mjs,jsx,ts,mts,tsx}": [
      "oxlint"
    ],
    "**/*.{js,cjs,mjs,jsx,ts,mts,tsx,html,md,json,css}": [
      "oxfmt --check"
    ]
  },
  "engines": {
    "node": ">=26.13.0",
    "pnpm": ">=12.16.1"
  },
  "packageManager": "pnpm@12.16.1"
}
