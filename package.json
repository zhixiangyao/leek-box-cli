{
  "name": "leek-box-cli",
  "version": "0.1.0",
  "description": "终端股票自选股看板, 基于 Ink 构建的交互式 CLI 工具",
  "keywords": [
    "a股",
    "cli",
    "ink",
    "quote",
    "stock",
    "tui",
    "watchlist"
  ],
  "license": "MIT",
  "author": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhixiangyao/leek-box-cli"
  },
  "bin": "dist/cli.mjs",
  "files": [
    "dist"
  ],
  "type": "module",
  "scripts": {
    "build": "vite build",
    "bundle": "pnpm build && pnpm sea",
    "sea": "node --build-sea=sea-config.json",
    "dev": "tsx src/cli.tsx",
    "mock": "tsx scripts/mock.ts",
    "preview": "node dist/cli.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint"
  },
  "dependencies": {
    "ink": "7.1.1",
    "meow": "14.1.0",
    "react": "19.2.8",
    "react-devtools-core": "7.0.1",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  },
  "engines": {
    "node": ">=26.7.0",
    "pnpm": ">=10.0.0"
  }
}
