{
  "name": "leek-box-cli",
  "version": "0.3.0",
  "description": "韭菜盒子, 终端股票自选股看板, 基于 Ink 构建的交互式 CLI 工具",
  "keywords": [
    "a股",
    "cli",
    "ink",
    "quote",
    "stock",
    "tui",
    "韭菜盒子"
  ],
  "homepage": "https://github.com/zhixiangyao/leek-box-cli#readme",
  "bugs": {
    "url": "https://github.com/zhixiangyao/leek-box-cli/issues"
  },
  "license": "MIT",
  "author": "zhixiangyao",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhixiangyao/leek-box-cli.git"
  },
  "bin": {
    "leek-box-cli": "dist/cli.mjs"
  },
  "files": [
    "dist/cli.mjs"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build",
    "dev": "tsx src/cli.tsx",
    "mock": "tsx scripts/mock.ts",
    "preview": "node dist/cli.mjs",
    "------------- TOOLS -------------": "",
    "release": "tsx scripts/release.tsx",
    "test": "vitest run --reporter=verbose",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --fix",
    "lint:check": "oxlint"
  },
  "dependencies": {
    "ink": "7.1.1",
    "meow": "14.1.0",
    "react": "19.2.8",
    "react-devtools-core": "7.0.1",
    "string-width": "8.2.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "@types/react": "19.2.18",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@12.1.0"
}
